NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info

# PostgreSQL/PostGIS (docker-compose.yml uses the same variables)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=weathermapz
DB_USER=weathermapz
DB_PASSWORD=change_me
DB_TEST_NAME=weathermapz_test
# Optional: overrides the DB_* values above (e.g. managed databases)
DATABASE_URL=
TEST_DATABASE_URL=

OPENROUTESERVICE_GEOCODING_BASE_URL=https://api.heigit.org/pelias/v1
OPENROUTESERVICE_DIRECTIONS_BASE_URL=https://api.openrouteservice.org/v2/directions
ORS_API_KEY=your_openrouteservice_api_key_here
