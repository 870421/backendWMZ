{
  "name": "weathermapz-backend",
  "version": "0.1.0",
  "private": true,
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "lint": "eslint src jest.config.js --max-warnings=0",
    "format": "prettier --write \"src/**/*.js\" \"*.{js,cjs,mjs,json,md}\" \".github/**/*.yml\"",
    "format:check": "prettier --check \"src/**/*.js\" \"*.{js,cjs,mjs,json,md}\" \".github/**/*.yml\"",
    "test": "jest --coverage",
    "check": "node --check src/server.js && node --check src/app.js",
    "ci": "npm run lint && npm run format:check && npm run check && npm test -- --runInBand"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^17.0.0",
    "express": "^5.1.0",
    "pg": "^8.13.0",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.0"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "5.10.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-stylistic-airbnb": "3.2.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.0",
    "prettier": "3.9.9",
    "supertest": "^7.0.0"
  }
}
