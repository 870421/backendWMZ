# Copia este fichero a /opt/weathermapz/.env en el servidor y rellena los valores reales.
# Nunca lo subas a Git.

# Dominio público. En Azure, la etiqueta DNS de la IP pública, p. ej. weathermapz.spaincentral.cloudapp.azure.com
DOMAIN=weathermapz.spaincentral.cloudapp.azure.com

# Imágenes publicadas por GitHub Actions en GHCR (en minúsculas)
BACKEND_IMAGE=ghcr.io/unizar-30248-2026-weathermapz/backend
FRONTEND_IMAGE=ghcr.io/unizar-30248-2026-weathermapz/frontend_web

LOG_LEVEL=info

# PostgreSQL/PostGIS (contenedor `db`, no se publica fuera del servidor)
DB_NAME=weathermapz
DB_USER=weathermapz
DB_PASSWORD=change_me_with_a_long_random_password

ORS_API_KEY=your_openrouteservice_api_key_here

# `openssl rand -hex 32`
JWT_SECRET=change_me_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# Opcionales: sin ellas solo funciona email/contraseña.
# En Google Cloud Console, la redirect URI autorizada es https://<DOMAIN>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
